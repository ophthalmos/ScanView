<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>ScanView.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>1.0.4</AssemblyVersion>
    <FileVersion>1.0.4</FileVersion>
    <Version>1.0.4</Version>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="PDFsharp-GDI" Version="6.5.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="tessdata\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- TWAIN-Helfer Twain32.exe und Twain64.exe (eigene Projekte für .NET Framework 4.8 in den Unterordnern Twain32
       und Twain64, gemeinsamer Quelltext in Twain32): nicht in ScanView mitkompilieren, aber mitbauen und neben
       ScanView.exe in die Ausgabe kopieren -->
  <ItemGroup>
    <Compile Remove="Twain32\**;Twain64\**" />
    <EmbeddedResource Remove="Twain32\**;Twain64\**" />
    <None Remove="Twain32\**;Twain64\**" />
    <ProjectReference Include="Twain32\Twain32.csproj;Twain64\Twain64.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CopyTwainHelpers" AfterTargets="Build">
    <MSBuild Projects="Twain32\Twain32.csproj;Twain64\Twain64.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="Platform">
      <Output TaskParameter="TargetOutputs" ItemName="_TwainHelperExe" />
    </MSBuild>
    <Copy SourceFiles="@(_TwainHelperExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Nur 64-Bit: die x86-Natives des Tesseract-Pakets (build\Tesseract.targets verlinkt x86\ UND x64\)
       nicht in die Ausgabe kopieren — das Paket-Target wird nach der Projektdatei importiert,
       darum geht das Entfernen nur in einem eigenen Target. -->
  <Target Name="PruneX86Natives" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_X86Native Include="@(None)" Condition="$([System.String]::Copy('%(None.Link)').StartsWith('x86\'))" />
      <None Remove="@(_X86Native)" />
    </ItemGroup>
  </Target>

  <!-- Übersetzungs-Konsistenz (deutscher Text = resx-Schlüssel): meldet nach jedem Build fehlende und verwaiste
       Schlüssel (LNG001/LNG002) – im Debug als Warnungen, im Release als Fehler mit Build-Abbruch (-Strict),
       s. check-lng.ps1 -->
  <Target Name="CheckTranslations" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\check-lng.ps1')">
    <Exec Condition="'$(Configuration)' != 'Release'" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\check-lng.ps1&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="true" />
    <Exec Condition="'$(Configuration)' == 'Release'" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\check-lng.ps1&quot; -Strict" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
