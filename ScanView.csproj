<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>ScanView.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Version>1.0.0</Version>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="PDFsharp-GDI" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <None Update="tessdata\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Nur 64-Bit: die x86-Natives des Tesseract-Pakets (build\Tesseract.targets verlinkt x86\ UND x64\)
       nicht in die Ausgabe kopieren — das Paket-Target wird nach der Projektdatei importiert,
       darum geht das Entfernen nur in einem eigenen Target. -->
  <Target Name="PruneX86Natives" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_X86Native Include="@(None)" Condition="$([System.String]::Copy('%(None.Link)').StartsWith('x86\'))" />
      <None Remove="@(_X86Native)" />
    </ItemGroup>
  </Target>
</Project>
